# ==============================================================================
# Environment Configuration - Inventory & Sales Management System
# ==============================================================================
# Copy this file to '.env' and adjust the values for your local environment.

# Django Core Settings
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# For PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=inventory_sales_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Note: If PostgreSQL is not installed locally during initial development,
# you can temporarily set DB_ENGINE=django.db.backends.sqlite3 and DB_NAME=db.sqlite3
